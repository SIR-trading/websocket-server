# ===========================================
# SIR WebSocket Server - Environment Variables
# ===========================================
# All vector variables must have the same number of comma-separated values.
# Order must match across CHAIN_IDS, RPC_URLS, and SIR_CONTRACT_ADDRESSES.

# Chain IDs to watch (comma-separated)
CHAIN_IDS=1,999,6343

# SIR token/staking/auction contract address (one per chain, comma-separated)
# This is the single contract that handles the SIR token, staking, dividends, and auctions.
# Source: App's public/build-data.json → contractAddresses.sir
SIR_CONTRACT_ADDRESSES=0x4Da4fb565Dcd5D5C5dB495205c109bA983A8ABa2,0xA06D0c5a8ADb7134903CA13D1FC0641731E2B766,0x214916fC5C98817cA304e5D43CbAD673C8Ff4416

# Allowed frontend origins (comma-separated)
FRONTEND_URLS=https://app.sir.trading,http://localhost:3000

# Server port
PORT=8080

# ===========================================
# Leaderboard Worker Configuration
# ===========================================

# Enable/disable leaderboard background worker
LEADERBOARD_WORKER_ENABLED=true

# Referral scoring worker (default: on). Set to "false" to disable, e.g. for local dev.
# REFERRAL_SCORING_WORKER_ENABLED=false

# Redis connection URL
REDIS_URL=redis://localhost:6379

# HTTP RPC URLs (one per chain, comma-separated)
# Used by event watchers (http polling) and leaderboard worker (multicalls)
RPC_URLS=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY,https://hyperliquid-mainnet.g.alchemy.com/v2/YOUR_API_KEY,https://megaeth-testnet.g.alchemy.com/v2/YOUR_API_KEY

# Subgraph URLs (one per chain, comma-separated)
SUBGRAPH_URLS=https://api.goldsky.com/api/private/project_xxx/subgraphs/sir-ethereum-subgraph-1/2.1.4/gn,https://api.goldsky.com/api/private/project_xxx/subgraphs/sir-hyperevm-subgraph-1/2.1.4/gn,https://api.goldsky.com/api/private/project_xxx/subgraphs/sir-megaeth-testnet-subgraph-1/2.1.4/gn

# Subgraph API key (optional, for authenticated endpoints)
SUBGRAPH_API_KEY=

# CoinGecko API key (optional, for price fetching)
COINGECKO_API_KEY=

# Maximum positions to process per worker run (default: 500)
MAX_POSITIONS_PER_RUN=500

# Assistant contract addresses (optional, uses defaults from build-data.json)
# ASSISTANT_ADDRESSES=0xff14f91285580AEd3733c0B1F3C8b6d04804c5ec,0x7d987b986FbA5e0A4247649A2334Bb2D4029656c,0x1642ceF4498B811f5F765b4FE5D3263fE26a1F9A

# Vault contract addresses
# Used for on-chain unclaimedRewards calls in leaderboard worker
VAULT_ADDRESSES=0x7Dad75dD36dE234C937C105e652B6E50d68b0309,0x4a35e7448Dad9cAc6B3e529050B5a6Ee56A0eDF0,0x8d694D1b369BdE5B274Ad643fEdD74f836E88543

# ===========================================
# LP Staking Stats Configuration
# ===========================================
# Real-time LP staking stats via contract event polling.
# Leave empty for chains without LP staking (e.g., Hyperliquid, MegaETH).
# Source: App's public/build-data.json → contractAddresses

# Uniswap V3 Staker addresses (one per chain, empty string for unsupported chains)
UNISWAP_V3_STAKER_ADDRESSES=0x1f98407aaB862CdDeF78Ed252D6f557aA5b0f00d,,

# NFT Position Manager addresses (one per chain, empty string for unsupported chains)
NFT_POSITION_MANAGER_ADDRESSES=0xC36442b4a4522E871399CD717aBDD847Ab11FE88,,

# SIR/Native 1% Pool addresses (one per chain, empty string for unsupported chains)
# e.g., SIR/WETH on Ethereum, SIR/HYPE on HyperEVM
SIR_NATIVE_POOL_ADDRESSES=0xYOUR_SIR_NATIVE_POOL_ADDRESS,,
